{
  "datasets": [
    {
      "name": "ds_vendas",
      "displayName": "Vendas (fato_vendas)",
      "queryLines": [
        "SELECT\n",
        "  pedido_id, item_id, data_pedido, ano, mes, make_date(ano, mes, 1) AS mes_ref,\n",
        "  canal, cliente_id, razao_social, segmento, cidade, vendedor_id,\n",
        "  sku, categoria, marca, nota_olfativa,\n",
        "  quantidade, preco_praticado, receita, custo, margem, devolucao\n",
        "FROM fato_vendas"
      ],
      "columns": [
        {"displayName": "Receita Total", "description": "Receita líquida (com devolução, negativa)", "expression": "SUM(`receita`)"},
        {"displayName": "Margem Total", "description": "Receita menos custo do produto", "expression": "SUM(`margem`)"},
        {"displayName": "Pedidos", "description": "Número de pedidos distintos", "expression": "COUNT(DISTINCT `pedido_id`)"},
        {"displayName": "Ticket Medio", "description": "Receita dividida pelo número de pedidos", "expression": "SUM(`receita`) / COUNT(DISTINCT `pedido_id`)"},
        {"displayName": "Margem Pct", "description": "Margem dividida pela receita, 0-1", "expression": "SUM(`margem`) * 1.0 / SUM(`receita`)"}
      ]
    },
    {
      "name": "ds_top_clientes",
      "displayName": "Top 20 clientes",
      "queryLines": [
        "SELECT cliente_id, razao_social, segmento, cidade, SUM(receita) AS receita\n",
        "FROM fato_vendas\n",
        "WHERE (size(:ano_filtro) = 0 OR array_contains(:ano_filtro, ano))\n",
        "  AND (size(:segmento_filtro) = 0 OR array_contains(:segmento_filtro, segmento))\n",
        "  AND (size(:cidade_filtro) = 0 OR array_contains(:cidade_filtro, cidade))\n",
        "GROUP BY cliente_id, razao_social, segmento, cidade\n",
        "ORDER BY receita DESC LIMIT 20"
      ],
      "parameters": [
        {"displayName": "Ano", "keyword": "ano_filtro", "dataType": "INTEGER", "complexType": "MULTI", "defaultSelection": {"values": {"dataType": "INTEGER", "values": []}}},
        {"displayName": "Segmento", "keyword": "segmento_filtro", "dataType": "STRING", "complexType": "MULTI", "defaultSelection": {"values": {"dataType": "STRING", "values": []}}},
        {"displayName": "Cidade", "keyword": "cidade_filtro", "dataType": "STRING", "complexType": "MULTI", "defaultSelection": {"values": {"dataType": "STRING", "values": []}}}
      ]
    }
  ],
